# ─────────────────────────────────────────────────────────────────
# ShopyBrain — Variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env a GitHub — ya está en .gitignore.
# ─────────────────────────────────────────────────────────────────

# Base de datos PostgreSQL
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=disable

# IA — Claude (Anthropic)
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXX

# Email marketing — Klaviyo
KLAVIYO_API_KEY=pk_XXXXXXXXXXXXXXXXXXXX

# Shopify OAuth (Partner App)
SHOPIFY_CLIENT_ID=XXXXXXXXXXXXXXXXXXXX
SHOPIFY_CLIENT_SECRET=shpss_XXXXXXXXXXXXXXXXXXXX

# Tienda propia (storefront público)
SHOP_DOMAIN=https://tu-tienda.myshopify.com/
STOREFRONT_ACCESS_TOKEN=shpss_XXXXXXXXXXXXXXXXXXXX

# Cifrado AES-256 para tokens de clientes
ENCRYPTION_KEY=genera-con-openssl-rand-hex-32

# Replit Object Storage
DEFAULT_OBJECT_STORAGE_BUCKET_ID=replit-objstore-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
PRIVATE_OBJECT_DIR=/replit-objstore-XXXXXXXX/.private
PUBLIC_OBJECT_SEARCH_PATHS=/replit-objstore-XXXXXXXX/public

# Generación de imágenes (Replicate)
REPLICATE_API_TOKEN=r8_XXXXXXXXXXXXXXXXXXXX

# ─────────────────────────────────────────────────────────────────
# SOLO para GitHub Actions — URL de la app desplegada en Replit
# Configúralo en: GitHub repo → Settings → Secrets → APP_URL
# ─────────────────────────────────────────────────────────────────
APP_URL=https://TU-APP.replit.app
