modules = ["nodejs-24", "java-graalvm22.3", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck-api"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck-frontend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test-api"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test-frontend"

[[workflows.workflow]]
name = "typecheck-api"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -o pipefail -c 'pnpm --filter @workspace/api-server run typecheck 2>&1 | tail -60'"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck-frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -o pipefail -c 'pnpm --filter @workspace/shopify-optimizer run typecheck 2>&1 | tail -60'"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test-api"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test-frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/shopify-optimizer run test"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["google-mail:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000

[userenv]

[userenv.shared]
COLLECTION_HANDLE = "shopify-automatization"
SHOP_CURRENCY = "EUR"
APP_URL = "https://shopycrafter.com"
ADMIN_EMAIL = "craftershopy@gmail.com"
ADMIN_NAME = "Joan Sadia Gil"

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 19080
externalPort = 3000
