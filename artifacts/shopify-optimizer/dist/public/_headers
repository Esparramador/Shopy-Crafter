# Shopy Crafter — HTTP Cache Headers for production deployment
# Compatible with Netlify, Cloudflare Pages, and Replit static hosting

# HTML: never cache (always fresh)
/*.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Service worker: no cache (always must fetch latest SW)
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /

# Manifest: short cache
/manifest.json
  Cache-Control: public, max-age=3600
  Content-Type: application/manifest+json

# Robots / Sitemap: cache 1 day
/robots.txt
  Cache-Control: public, max-age=86400
/sitemap.xml
  Cache-Control: public, max-age=86400

# Hashed JS/CSS bundles (content-hashed by Vite) — immutable 1 year
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable
/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

# Images: stale-while-revalidate (1 day cache, 1 day revalidate in background)
/assets/*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400
/assets/*.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400
/assets/*.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400
/assets/*.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

# Static public images: 7-day cache
/images/*
  Cache-Control: public, max-age=604800
/icons/*
  Cache-Control: public, max-age=604800

# Video: 1-hour cache (they're big but also rarely change)
/assets/videos/*
  Cache-Control: public, max-age=3600

# Fonts from Google are already CDN-cached; these are local copies if any
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Design system CSS: 7-day with revalidation
/css/design-system.css
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
