{
  "name": "@workspace/shopify-optimizer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts && vite build --ssr src/entry-server.tsx --outDir dist/server --config vite.config.ts && node prerender.mjs && node -e \"const fs=require('fs');const isDeployment=process.env.REPLIT_DEPLOYMENT==='1';const paths=['dist/public/assets/3d'];if(isDeployment){paths.push('public/assets/3d','../../attached_assets')}paths.forEach(p=>{try{fs.rmSync(p,{recursive:true,force:true});console.log('Removed '+p+' (deployment size optimization)')}catch(e){}});\"",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e:voice-call": "node e2e/convai-voice-call.e2e.mjs",
    "e2e:voice-call:client": "E2E_MODE=client node e2e/convai-voice-call.e2e.mjs",
    "e2e:cleanup-users": "node e2e/cleanup-e2e-users.mjs",
    "e2e:client-chatbot-layout": "node e2e/client-chatbot-layout.e2e.mjs",
    "e2e:admin-delete-client": "node e2e/admin-delete-client.e2e.mjs",
    "e2e:admin-modal-overlay": "node e2e/admin-modal-overlay.e2e.mjs"
  },
