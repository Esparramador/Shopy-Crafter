      "brace-expansion@^2": ">=2.0.3",
      "brace-expansion@^5": ">=5.0.12",
      "brace-expansion": ">=5.0.12",
      "fast-xml-parser": ">=5.7.0",
      "follow-redirects": ">=1.16.0",
      "postcss": ">=8.5.23",
      "fast-uri": ">=4.0.0",
      "fast-xml-builder": ">=1.2.0",
      "tmp": ">=0.2.7",
      "ws": ">=8.21.0",
      "qs": ">=6.16.0",
      "ip-address": ">=10.7.1",
      "esbuild": ">=0.28.0",
      "uuid": ">=11.1.1",
      "@tootallnate/once": ">=2.0.1",
      "proxy-addr": ">=2.0.8",
      "tar": ">=7.5.21",
      "image-size": ">=2.0.3",
      "nanoid@^3": ">=3.3.18",
